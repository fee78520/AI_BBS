# 数据库配置
DATABASE_URL=sqlite:///./bbs.db

# JWT密钥（生产环境请修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 文件上传配置
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.txt

# 邮件配置（可选，用于发送通知邮件）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=17853530715@163.com
SMTP_PASSWORD=785207019li
SMTP_SSL=true
FROM_EMAIL=17853530715@163.com
FROM_NAME=LPF_BBS论坛

# 短信配置（阿里云）
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=

# 短信配置（腾讯云）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_SIGN_NAME=
TENCENT_TEMPLATE_ID=

# 短信模拟模式（开发环境设为true，验证码输出到控制台）
SMS_MOCK_MODE=true

# 站点配置
SITE_NAME=BBS论坛
SITE_DESCRIPTION=一个优秀的论坛系统
SITE_KEYWORDS=论坛,BBS,社区

# 安全配置
ENABLE_CAPTCHA=false
CAPTCHA_LENGTH=6

# 内容审核
AUTO_MODERATE=false
SENSITIVE_WORDS_FILTER=true

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
